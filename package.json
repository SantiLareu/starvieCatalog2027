{
  "name": "starvie-2027-catalog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "build:pdf-pages": "node scripts/build-pdf-pages.mjs",
    "products:seed": "node scripts/seed-pilot-xlsx.mjs",
